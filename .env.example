# Garmin Connect Authentication
# Credentials used for Garmin Connect API access
GARMIN_USERNAME=your@email.com
GARMIN_PASSWORD=yourpassword

# Token Storage
# Garmin authentication tokens are automatically stored in:
#   .garminworkouts-cache/garmin/
# This directory is created during first authentication and contains cached
# session tokens to avoid repeated login attempts. You do not need to
# configure this path — it will be created automatically when the app
# authenticates with Garmin Connect.

# Athlete Performance Profile
# Critical velocity (in format: min/km or min/mi depending on locale)
vV02=5:00

# Heart rate zones
# Minimum resting heart rate (bpm)
fmin=45
# Running VO2max heart rate (bpm)
rfmax=185
# Running lactate threshold heart rate (bpm)
rflt=168
# Cycling VO2max heart rate (bpm)
cfmax=166
# Cycling lactate threshold heart rate (bpm)
cflt=148
# Swimming VO2max heart rate (bpm)
sfmax=185
# Swimming lactate threshold heart rate (bpm)
sflt=167

# Functional Threshold Power (FTP)
# Running critical power (e.g., 358w for 358 watts)
rFTP=358w
# Cycling FTP (e.g., 270w for 270 watts)
cFTP=270w

# Telegram Bot Configuration (optional)
# Token for Telegram bot integration
BOT_TOKEN=your_telegram_bot_token

# Volume Mount (optional, for Docker deployment)
# Root path for workout files (default is current directory)
VOLUME=.

# Intervals.icu Integration (optional)
# API key for Intervals.icu platform access
intervals_api_key=your_intervals_icu_api_key
# Athlete ID on Intervals.icu platform
intervals_athlete_id=your_athlete_id
